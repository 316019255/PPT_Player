# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local data — 数据库（含密码哈希、开发密钥）与用户上传素材，不要进版本库
/data
/public/uploads

# vercel
.vercel

# temporary browser profiles and test artifacts
edge-tmp-play
dev-server.tmp.log
probe-*.tmp
probe-*.mjs

# typescript
*.tsbuildinfo
next-env.d.ts
