# 生产环境必填，至少 32 个字符的随机串（缺失时应用会拒绝签发/校验登录态）
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 未接入支付前，生产环境默认关闭「自助升级 Pro」。本地或演示环境设为 1 才开放
ENABLE_DEV_PRO_GRANT=0

# Postgres 连接串，服务端专用：绝对不要加 NEXT_PUBLIC_ 前缀（加了会被打进浏览器包）。
# Supabase 取 Dashboard → Settings → Database → Connection string (URI) 里 **pooled / 6543** 那一条，
# 用户名形如 postgres.<project-ref>。表结构用 npm run db:push 应用。
DATABASE_URL=

# 可选。pooler 的证书出自 Supabase 自建 CA（Supabase Root 2021 CA），不在系统信任库里，
# 所以默认只加密、不验证链。把那张根证书 PEM 原文（含 BEGIN/END 行）填进来即切换为完整校验。
DATABASE_CA_CERT=

# ===== 云端素材（幻灯片里的图片可以存到云上，换设备也看得到）=====
# 都只在服务端用，绝对不要加 NEXT_PUBLIC_ 前缀。Dashboard → Project Settings → API Keys 里取。
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 素材桶名，留空按 slide-media 走。建桶/校配置：npm run media:setup
# 该命令会把下面两行的正确取值直接打印出来，照抄即可。
SUPABASE_MEDIA_BUCKET=

# 唯一一个必须带 NEXT_PUBLIC_ 前缀的：浏览器要用它把桶内路径拼成能显示的地址，
# 所以它不是密钥（形如 {SUPABASE_URL}/storage/v1/object/public/{桶名}）。
# 不填 = 云端功能整体关闭：不给云端入口，已有的云端图片按「缺素材」降级成纯色。
NEXT_PUBLIC_MEDIA_PUBLIC_BASE=

# 只有 npm run media:setup --verify 的匿名探针要用（验证「公开 key 签不出上传地址」），应用本身不读。
SUPABASE_PUBLISHABLE_KEY=

# ===== 后台管理 =====
# 管理员邮箱白名单，逗号分隔，不区分大小写。留空 = 后台整个关着：
# /admin 会退回 /dashboard，/api/admin/* 一律 401/403，没有任何兜底通道。
# 只填真实注册过的邮箱；游客账号的合成邮箱（guest_xxx@ppt-player.local）即使误填在这里也不会被放行。
ADMIN_EMAILS=
